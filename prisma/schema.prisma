generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatType {
  PRIVATE
  GROUP
  SAVED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  SYSTEM
  CALL
}

enum CallKind {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACCEPTED
  ENDED
  MISSED
  DECLINED
}

model User {
  id                String             @id @default(cuid())
  login             String             @unique
  username          String             @unique
  passwordHash      String
  displayName       String
  avatarData        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       ChatMember[]
  messages          Message[]          @relation("UserMessages")
  pushSubscriptions PushSubscription[]
  callsStarted      CallSession[]      @relation("CallCaller")

  @@index([login])
  @@index([username])
}

model Chat {
  id        String        @id @default(cuid())
  type      ChatType      @default(PRIVATE)
  title     String?
  avatarData String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   ChatMember[]
  messages  Message[]
  calls     CallSession[]
}

model ChatMember {
  id       String   @id @default(cuid())
  userId   String
  chatId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  lastReadAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
  @@index([chatId])
  @@index([userId])
}

model Message {
  id        String      @id @default(cuid())
  chatId    String
  senderId  String?
  type      MessageType @default(TEXT)
  text      String?
  mediaData String?
  mediaMime String?
  mediaName String?
  createdAt DateTime    @default(now())
  editedAt  DateTime?

  chat   Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User? @relation("UserMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt])
  @@index([senderId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CallSession {
  id          String     @id @default(cuid())
  chatId      String
  callerId    String
  kind        CallKind
  status      CallStatus @default(RINGING)
  offer       Json?
  answer      Json?
  callerIce   Json?
  receiverIce Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  endedAt     DateTime?

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  caller User @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([callerId])
}
